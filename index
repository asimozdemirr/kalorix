// ============================================================
// SEARCH STATE
// ============================================================
let curCat='all', curQ='', actCurCat='all', actCurQ='';

function doCat(c,btn){
  curCat=c; curQ=''; document.getElementById('srch-inp').value='';
  document.querySelectorAll('.catbtn').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on'); renderFoods();
}
function doSearch(q){curQ=q.toLowerCase();renderFoods();}
function renderFoods(){
  let list=FOODS;
  if(curCat!=='all') list=list.filter(f=>f.c===curCat);
  if(curQ) list=list.filter(f=>f.n.toLowerCase().includes(curQ));
  const g=document.getElementById('fgrid');
  if(!list.length){g.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted)">Sonuç bulunamadı 😕</div>';return;}
  const w=S.userWeight||70;
  g.innerHTML=list.slice(0,60).map(f=>`
    <div class="fcard" onclick="openFS(${JSON.stringify(f).replace(/"/g,'&quot;')})">
      <div class="femo">${f.e}</div>
      <div class="finfo"><div class="fname">${f.n}</div><div class="fsub">100${f.u} • P:${f.p}g K:${f.ch}g Y:${f.f}g</div></div>
      <div><div class="fkcal">${f.k}</div><span class="fkcal-u">kcal</span></div>
    </div>`).join('');
}

// ============================================================
// FOOD SHEET
// ============================================================
let curFood=null, fsPortion=100, fsMeal='breakfast';
function openFS(food){
  curFood=food; fsPortion=100;
  document.getElementById('fs-emo').textContent=food.e;
  document.getElementById('fs-name').textContent=food.n;
  const cats={turk:'Türk Mutfağı',pilav:'Pilav & Makarna',corba:'Çorbalar',kebap:'Kebap & Köfte',borek:'Börek & Hamur',tatli:'Tatlılar',atistirma:'Atıştırmalık',icecek:'İçecekler',dunya:'Dünya Mutfağı',meyve:'Meyveler',sebze:'Sebzeler',et:'Et & Balık',sut:'Süt & Peynir',ekmek:'Ekmek & Tahıl'};
  document.getElementById('fs-cat').textContent=cats[food.c]||food.c;
  document.getElementById('fs-sli').value=100; updFS(100);
  document.querySelectorAll('#fs-meals .msbtn').forEach(b=>{b.classList.remove('on');b.onclick=()=>{document.querySelectorAll('#fs-meals .msbtn').forEach(x=>x.classList.remove('on'));b.classList.add('on');fsMeal=b.dataset.m;};});
  document.querySelector('#fs-meals .msbtn').classList.add('on');
  fsMeal='breakfast';
  document.getElementById('fov').classList.add('on');
}
function updFS(v){
  fsPortion=parseInt(v); const m=v/100, f=curFood;
  document.getElementById('fs-kcal').textContent=Math.round(f.k*m);
  document.getElementById('fs-pdis').textContent=v+f.u;
  document.getElementById('fs-pv').textContent=v+f.u;
  document.getElementById('fs-p').textContent=Math.round(f.p*m)+'g';
  document.getElementById('fs-c').textContent=Math.round(f.ch*m)+'g';
  document.getElementById('fs-f').textContent=Math.round(f.f*m)+'g';
}
function closeFS(){document.getElementById('fov').classList.remove('on');}
function addFoodToLog(){
  const m=fsPortion/100, f=curFood;
  S.meals.find(x=>x.id===fsMeal).items.push({name:f.n,portion:fsPortion,kcal:Math.round(f.k*m),protein:Math.round(f.p*m),carb:Math.round(f.ch*m),fat:Math.round(f.f*m)});
  save(); closeFS(); toast('✅ '+f.n+' eklendi!');
}

// ============================================================
// ACTIVITY LIST & SHEET
// ============================================================
let curAct=null, actDur=30, actInt=0.8;
function doActCat(c,btn){actCurCat=c;actCurQ='';document.getElementById('asrch').value='';document.querySelectorAll('.acabtn').forEach(b=>b.classList.remove('on'));btn.classList.add('on');renderActGrid();}
function doActSearch(q){actCurQ=q.toLowerCase();renderActGrid();}
function calcAK(a,dur,w,int){return Math.round(a.met*w*(dur/60)*int);}
function renderActGrid(){
  let list=ACTS;
  if(actCurCat!=='all') list=list.filter(a=>a.c===actCurCat);
  if(actCurQ) list=list.filter(a=>a.n.toLowerCase().includes(actCurQ));
  const g=document.getElementById('agrid');
  if(!list.length){g.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted)">Bulunamadı 😕</div>';return;}
  const w=S.userWeight||70;
  g.innerHTML=list.map(a=>`
    <div class="acard" onclick="openAS(${JSON.stringify(a).replace(/"/g,'&quot;')})">
      <div class="aico">${a.e}</div>
      <div class="ainfo"><div class="aname">${a.n}</div><div class="asub">MET:${a.met} • 30dk tahmini</div></div>
      <div><div class="akcal">~${calcAK(a,30,w,1.0)}</div><span class="akcal-u">kcal/30dk</span></div>
    </div>`).join('');
}
function openAS(act){
  curAct=act; actDur=30; actInt=0.8;
  document.getElementById('as-emo').textContent=act.e;
  document.getElementById('as-name').textContent=act.n;
  const catN={kardiyo:'Kardiyo',guc:'Güç Antrenmanı',spor:'Spor',su:'Su Sporları',gunluk:'Günlük',esneme:'Esneme'};
  document.getElementById('as-cat').textContent=catN[act.c]||act.c;
  document.getElementById('dur-v').textContent=actDur;
  document.getElementById('w-inp').value=S.userWeight||70;
  document.querySelectorAll('.intbtn').forEach(b=>b.classList.remove('on'));
  document.querySelector('.intbtn[data-i="0.8"]').classList.add('on');
  updAS();
  document.getElementById('aov').classList.add('on');
}
function closeAS(){document.getElementById('aov').classList.remove('on');}
function chDur(d){actDur=Math.max(5,Math.min(300,actDur+d));document.getElementById('dur-v').textContent=actDur;updAS();}
function selInt(btn,v){actInt=v;document.querySelectorAll('.intbtn').forEach(b=>b.classList.remove('on'));btn.classList.add('on');updAS();}
function updAS(){if(!curAct)return;const w=parseFloat(document.getElementById('w-inp').value)||70;S.userWeight=w;document.getElementById('as-kcal').textContent=calcAK(curAct,actDur,w,actInt);}
function addActToLog(){
  const w=parseFloat(document.getElementById('w-inp').value)||70;
  const kcal=calcAK(curAct,actDur,w,actInt);
  const iL={0.8:'Hafif',1.0:'Orta',1.3:'Yüksek',1.6:'Maksimum'};
  S.activities.push({name:curAct.n,emoji:curAct.e,duration:actDur,kcalBurned:kcal,intensity:iL[actInt]||'Orta'});
  S.userWeight=w; save(); closeAS(); toast('🔥 '+curAct.n+' • '+kcal+' kcal yakıldı');
}
function removeAct(i){S.activities.splice(i,1);save();renderDaily();}
function removeMealItem(mid,i){S.meals.find(m=>m.id===mid).items.splice(i,1);save();renderDaily();}

// ============================================================
// DAILY RENDER
// ============================================================
const DAYS=['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
const MONTHS=['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
function renderDaily(){
  const d=new Date();
  document.getElementById('daily-date').textContent=`${DAYS[d.getDay()]}, ${d.getDate()} ${MONTHS[d.getMonth()]}`;
  let tk=0,tp=0,tc=0,tf=0;
  S.meals.forEach(m=>m.items.forEach(i=>{tk+=i.kcal||0;tp+=i.protein||0;tc+=i.carb||0;tf+=i.fat||0;}));
  const bk=(S.activities||[]).reduce((s,a)=>s+(a.kcalBurned||0),0);
  const net=tk-bk;
  // Ring
  const pct=Math.max(0,Math.min(net/S.target,1));
  document.getElementById('main-ring').style.strokeDashoffset=251-(pct*251);
  document.getElementById('rv').textContent=net;
  document.getElementById('rs-t').textContent=S.target;
  const left=S.target-net;
  document.getElementById('rs-l').textContent=Math.max(0,left);
  document.getElementById('rs-l').style.color=left<0?'var(--a3)':'#00c98c';
  document.getElementById('rs-c').textContent=tk;
  document.getElementById('rs-b').textContent=bk;
  // Macros
  document.getElementById('dp').textContent=tp+'g';
  document.getElementById('dc').textContent=tc+'g';
  document.getElementById('df').textContent=tf+'g';
  document.getElementById('dpb').style.width=Math.min(tp/S.targets.protein*100,100)+'%';
  document.getElementById('dcb').style.width=Math.min(tc/S.targets.carb*100,100)+'%';
  document.getElementById('dfb').style.width=Math.min(tf/S.targets.fat*100,100)+'%';
  // Balance
  const bal=net-S.target;
  let cls,sign,lbl,emo;
  if(Math.abs(bal)<50){cls='neu';sign='±';lbl='Denge mükemmel! Hedefe tam isabet 🎯';emo='⚖️';}
  else if(bal>0){cls='sur';sign='+';lbl=`Hedefi ${bal} kcal aştın. Yarın biraz dikkatli ol 💡`;emo='📈';}
  else{cls='def';sign='';lbl=`${Math.abs(bal)} kcal açıkla harika gidiyorsun! 💪`;emo='📉';}
  document.getElementById('bal-area').innerHTML=`
    <div class="bal ${cls}">
      <div class="bal-lbl">${emo} Günlük Net Denge</div>
      <div class="bal-num ${cls}">${sign}${bal} <span style="font-size:18px;opacity:.5">kcal</span></div>
      <div class="bal-txt">${lbl}</div>
      <div class="bal-g">
        <div class="bg"><div class="bg-v" style="color:var(--a4)">${tk}</div><div class="bg-l">Alınan</div></div>
        <div class="bg"><div class="bg-v" style="color:var(--a3)">−${bk}</div><div class="bg-l">Yakılan</div></div>
        <div class="bg"><div class="bg-v" style="color:var(--a1)">${net}</div><div class="bg-l">Net</div></div>
      </div>
    </div>`;
  // Act log
  document.getElementById('act-tot').textContent=bk+' kcal yakıldı';
  document.getElementById('al-list').innerHTML=(S.activities||[]).map((a,i)=>`
    <div class="alitem">
      <span style="font-size:16px;margin-right:7px">${a.emoji}</span>
      <span class="alitem-n">${a.name}</span>
      <span class="alitem-d">${a.duration}dk • ${a.intensity}</span>
      <span class="alitem-k">−${a.kcalBurned}</span>
      <button class="del" onclick="removeAct(${i})">✕</button>
    </div>`).join('');
  // Meal log
  const ml=document.getElementById('meal-log'); ml.innerHTML='';
  S.meals.forEach(meal=>{
    const mk=meal.items.reduce((s,i)=>s+(i.kcal||0),0);
    const d=document.createElement('div');
    d.innerHTML=`
      <div class="mhdr"><span>${meal.name}</span><span class="mhdr-k">${mk} kcal</span></div>
      <div class="mitems">
        ${meal.items.map((it,i)=>`<div class="mitem"><span class="mitem-n">${it.name}</span><span class="mitem-p">${it.portion}g</span><span class="mitem-k">${it.kcal}</span><button class="del" onclick="removeMealItem('${meal.id}',${i})">✕</button></div>`).join('')}
        <button class="add-food-btn" onclick="go('srch',document.querySelectorAll('.nb')[1]);renderFoods()">＋ Yemek Ekle</button>
      </div>`;
    ml.appendChild(d);
  });
}

