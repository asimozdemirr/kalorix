<script>
// ============================================================
// GEMINI API KEY BURAYA
// ============================================================
const GEMINI_API_KEY = "AQ.Ab8RN6LNxZtUPEExZaYGCQwKj4dJlDTPnx5pzpmi7b_QDLvFUg";

// ============================================================
// STATE — sadece localStorage (bulut yok, üyelik yok)
// ============================================================
const DEF = {
  target:2000, targets:{protein:150,carb:200,fat:65},
  meals:[
    {id:'breakfast',name:'🌅 Kahvaltı',items:[]},
    {id:'lunch',name:'☀️ Öğle',items:[]},
    {id:'dinner',name:'🌙 Akşam',items:[]},
    {id:'snack',name:'🍎 Atıştırmalık',items:[]}
  ],
  activities:[], userWeight:70,
  aiUsedToday:0, aiLastDate:''
};
let S = {...DEF};
try{const raw=localStorage.getItem('kx3');if(raw){const p=JSON.parse(raw);S={...DEF,...p};}}catch(e){}
// Ensure meals structure
if(!S.meals||S.meals.length<4) S.meals=DEF.meals.map(m=>({...m,items:[]}));
if(!S.activities) S.activities=[];

function save(){try{localStorage.setItem('kx3',JSON.stringify(S));}catch(e){}}

// ============================================================
// AI QUOTA — 25/gün
// ============================================================
const AI_DAILY_LIMIT = 25;
function getToday(){return new Date().toISOString().slice(0,10);}
function checkQuota(){
  if(S.aiLastDate !== getToday()){S.aiUsedToday=0; S.aiLastDate=getToday(); save();}
  return S.aiUsedToday < AI_DAILY_LIMIT;
}
function useQuota(){S.aiUsedToday++; S.aiLastDate=getToday(); save(); renderQuota();}
function renderQuota(){
  if(S.aiLastDate !== getToday()){S.aiUsedToday=0;}
  const used=S.aiUsedToday, rem=AI_DAILY_LIMIT-used;
  document.getElementById('quota-txt').textContent=`${rem} / ${AI_DAILY_LIMIT} kaldı`;
  const dots=document.getElementById('qdots');
  dots.innerHTML='';
  for(let i=0;i<AI_DAILY_LIMIT;i++){
    const d=document.createElement('div');
    d.className='qdot'+(i<used?' used':'');
    dots.appendChild(d);
    if(i>9){dots.lastChild.style.display='none';} // max 10 dots shown
  }
}

// ============================================================
// NAVIGATION
// ============================================================
function go(id,btn){
  document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));
  document.querySelectorAll('.nb').forEach(b=>b.classList.remove('on'));
  document.getElementById('s-'+id).classList.add('on');
  if(btn) btn.classList.add('on');
  document.getElementById('scr-body').scrollTop=0;
}
function goAct(){go('act',document.querySelectorAll('.nb')[3]);renderActGrid();}

// ============================================================
// SCAN MODE
// ============================================================
let scanMode = 'plate'; // 'plate' or 'pkg'
function setMode(m){
  scanMode=m;
  document.getElementById('tab-plate').classList.toggle('on',m==='plate');
  document.getElementById('tab-pkg').classList.toggle('on',m==='pkg');
  const box=document.getElementById('cam-box');
  box.classList.toggle('pkg',m==='pkg');
  document.getElementById('cam-ph-ico').textContent = m==='plate'?'🍽️':'📦';
  document.getElementById('cam-ph-txt').innerHTML = m==='plate'
    ? 'Tabağın fotoğrafını çek<br>veya galerinden yükle<br><strong>AI yemeği tanıyıp kalorisini hesaplar</strong>'
    : 'Paketin <strong>besin değerleri tablosunu</strong><br>fotoğrafla — AI kalorileri<br><strong>otomatik okuyup ekler</strong>';
  const cap=document.getElementById('btn-cap');
  cap.classList.toggle('pkg',m==='pkg');
  document.getElementById('result-area').innerHTML='';
  stopCam();
}
function openGallery(){document.getElementById(scanMode==='plate'?'file-inp':'file-inp2').click();}

// ============================================================
// CAMERA
// ============================================================
let stream=null, camOn=false;
async function toggleCam(){
  if(camOn){stopCam();return;}
  try{
    stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:1280}}});
    const v=document.getElementById('vid'); v.srcObject=stream; v.style.display='block';
    document.getElementById('cam-ph').style.display='none';
    document.getElementById('prev').style.display='none';
    document.getElementById('btn-cap').style.display='flex';
    document.getElementById('btn-cap').textContent='📸 Çek';
    document.getElementById('btn-cam').textContent='⏹ Dur';
    camOn=true;
  }catch(e){alert('Kamera izni reddedildi. Galeri kullanabilirsiniz.');}
}
function stopCam(){
  if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}
  document.getElementById('vid').style.display='none';
  document.getElementById('cam-ph').style.display='flex';
  document.getElementById('btn-cap').style.display='none';
  document.getElementById('btn-cam').textContent='📷 Kamera';
  camOn=false;
}
async function capOrAnalyze(){
  if(camOn){
    const v=document.getElementById('vid'), c=document.getElementById('cnv');
    c.width=v.videoWidth; c.height=v.videoHeight;
    c.getContext('2d').drawImage(v,0,0);
    const dataUrl=c.toDataURL('image/jpeg',.85);
    stopCam();
    showPreview(dataUrl);
    await analyzeImg(dataUrl, scanMode);
  }
}
function showPreview(dataUrl){
  const p=document.getElementById('prev');
  p.src=dataUrl; p.style.display='block';
  document.getElementById('cam-ph').style.display='none';
  document.getElementById('btn-cap').textContent='🔄 Tekrar';
  document.getElementById('btn-cap').style.display='flex';
}
function handleFile(e, mode){
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=async ev=>{showPreview(ev.target.result); await analyzeImg(ev.target.result, mode);};
  r.readAsDataURL(f);
  e.target.value='';
}

// ============================================================
// AI IMAGE ANALYSIS (GEMINI API)
// ============================================================
async function analyzeImg(dataUrl, mode){
  if(!GEMINI_API_KEY || GEMINI_API_KEY === "BURAYA_API_ANAHTARINIZI_YAZIN"){
    showErr('Lütfen kodun içindeki GEMINI_API_KEY kısmına kendi anahtarınızı yazın.');
    return;
  }

  if(!checkQuota()){
    showErr('Günlük 25 AI sorgu limitine ulaştın. Yarın devam edebilirsin! 🌙');
    return;
  }
  document.getElementById('result-area').innerHTML='';
  const an=document.getElementById('analyzing'); an.style.display='flex';
  const spn=document.getElementById('spin'); spn.classList.toggle('pkg',mode==='pkg');
  const anTxt=document.getElementById('an-txt'); anTxt.classList.toggle('pkg',mode==='pkg');
  document.getElementById('an-strong').textContent = mode==='plate'?'🤖 AI Analiz Ediyor...':'📦 Etiket Okunuyor...';
  document.getElementById('an-sub').textContent = mode==='plate'?'Yemekler tespit ediliyor':'Besin değerleri taranıyor';

  const b64=dataUrl.split(',')[1];
  const mime=dataUrl.split(';')[0].split(':')[1];

  const sysPkg=`Sen bir beslenme uzmanı ve paket etiketi okuma uzmanısın. Görseldeki PAKETLİ GIDA besin değerleri tablosunu oku. SADECE eksiksiz ve geçerli bir JSON objesi döndür. Kesinlikle markdown (```json) vb. ekleme. Sadece şu özellikleri barındırsın:
{"detected":true, "productName":"Ürün adı", "emoji":"📦", "serving":"100g", "kcalPer100":250, "kcalPerServing":125, "servingSize":"50g", "protein":5, "carb":30, "fat":8, "sugar":10, "fiber":2, "sodium":200, "note":"Kısa not"}. Eğer tablo yoksa: {"detected":false}`;

  const sysPlate=`Sen uzman bir diyetisyensin. Görseldeki tabak/yemek içeriğini analiz et. SADECE eksiksiz ve geçerli bir JSON objesi döndür. Kesinlikle markdown (```json) vb. ekleme. Sadece şu özellikleri barındırsın:
{"detected":true, "mainDish":"Ana yemek", "emoji":"🍽️", "confidence":85, "totalKcal":450, "items":[{"name":"Yemek","portion":"150g","kcal":250,"protein":20,"carb":15,"fat":10}], "totalProtein":23, "totalCarb":27, "totalFat":12, "note":"Kısa not"}. Eğer yemek göremiyorsan: {"detected":false}`;

  const promptText = mode === 'pkg' ? sysPkg : sysPlate;

  try{
    const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{
          role: 'user',
          parts: [
            { text: promptText },
            { inline_data: { mime_type: mime, data: b64 } }
          ]
        }],
        generationConfig: {
          response_mime_type: "application/json"
        }
      })
    });
    
    an.style.display='none';
    
    if(!res.ok){
      showErr('API Hatası: ' + res.status);
      return;
    }
    
    useQuota();
    const data=await res.json();
    
    const txt = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
    let result;
    try{
        result=JSON.parse(txt);
    }catch(e){
        showErr('AI yanıtı çözümlenemedi.');
        return;
    }

    if(!result.detected){showErr(mode==='pkg'?'Paket etiketi bulunamadı. Besin değerleri tablosunu netçe çek.':'Yemek tespit edilemedi. Daha net fotoğraf dene.');return;}
    mode==='pkg'?renderPkgResult(result):renderPlateResult(result);
  }catch(e){
    an.style.display='none';
    showErr('Bağlantı hatası. İnternet bağlantınızı kontrol edin.');
  }
}

